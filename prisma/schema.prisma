generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Member {
  id            Int       @id @default(autoincrement())
  firstName     String
  lastName      String
  dni           String    @unique
  phone         String?
  address       String?
  district      String?
  birthDate     DateTime?
  maritalStatus String?
  gender        String
  familyGroup   String?
  isBaptized    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  dni       String   @unique
  name      String
  email     String?  @unique
  password  String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  memberId  Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  dni       String
  token     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
